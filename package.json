{
  "name": "@ushironoko/gistdex",
  "version": "1.6.5",
  "description": "RAG search system for Gist, GitHub, and Local Files.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gistdex": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "templates",
    "package.json"
  ],
  "scripts": {
    "dev": "tsdown --watch --tsconfig tsconfig.app.json",
    "build": "tsdown --tsconfig tsconfig.app.json",
    "start": "node dist/cli/index.js",
    "test": "vitest run --config vitest.config.unit.ts",
    "test:integration": "vitest run --config vitest.config.integration.ts && tsx scripts/cleanup-test-dirs.ts",
    "test:all": "pnpm run test && pnpm run test:integration",
    "lint": "biome check --write .",
    "format": "biome format --write .",
    "tsc": "tsgo --project tsconfig.app.json --noEmit && tsgo --project tsconfig.test.json --noEmit",
    "run-all": "pnpm format && pnpm run lint && pnpm run tsc && pnpm run test && pnpm run build && pnpm run docs:build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "rag",
    "vector-search",
    "embeddings",
    "gist",
    "github",
    "cli",
    "ai",
    "llm"
  ],
  "author": "ushironoko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ushironoko/gistdex.git"
  },
  "bugs": {
    "url": "https://github.com/ushironoko/gistdex/issues"
  },
  "homepage": "https://github.com/ushironoko/gistdex#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@ai-sdk/google": "3.0.43",
    "@duckdb/node-api": "1.5.0-r.1",
    "@inquirer/prompts": "8.3.0",
    "@modelcontextprotocol/sdk": "1.27.1",
    "ai": "6.0.116",
    "consola": "3.4.2",
    "defu": "6.1.4",
    "gunshi": "0.29.3",
    "picomatch": "4.0.3",
    "sqlite-vec": "0.1.6",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.24.5",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.6",
    "@iconify-json/vscode-icons": "1.2.45",
    "@iconify/json": "2.2.448",
    "@types/bun": "1.3.10",
    "@types/node": "25.4.0",
    "@types/picomatch": "4.0.2",
    "@typescript/native-preview": "7.0.0-dev.20260311.1",
    "@vitest/coverage-v8": "4.0.18",
    "tsdown": "0.21.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitepress": "2.0.0-alpha.12",
    "vitepress-plugin-group-icons": "1.7.1",
    "vitepress-plugin-llms": "1.11.0",
    "vitest": "4.0.18"
  },
  "packageManager": "pnpm@10.15.0"
}
